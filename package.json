{
  "name": "setu",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @setu/api db:generate",
    "db:migrate": "pnpm --filter @setu/api db:migrate",
    "db:migrate:deploy": "pnpm --filter @setu/api db:deploy",
    "db:seed": "pnpm --filter @setu/api db:seed:dev",
    "db:seed:dev": "pnpm --filter @setu/api db:seed:dev",
    "db:seed:prod": "pnpm --filter @setu/api db:seed:prod",
    "release:verify": "pnpm format:check && pnpm db:generate && turbo run lint typecheck test test:e2e --force && turbo run build --force && pnpm audit --audit-level high",
    "smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-test.ps1"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "15.5.22",
    "@setu/config": "workspace:*",
    "prettier": "^3.3.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
