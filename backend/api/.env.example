NODE_ENV=development
API_PORT=4000
PUBLIC_WEB_URL=http://localhost:3000
# Google Identity Services for public-user sign-in. Register http://localhost:3000 as an authorized JavaScript origin.
GOOGLE_OAUTH_CLIENT_ID=
# MSG91 OTP. Enable only after creating an approved OTP template in MSG91.
MSG91_OTP_ENABLED=false
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
DATABASE_URL=postgresql://setu:setu_local_password@localhost:5432/setu?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-local-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-local-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ADMIN_SEED_EMAIL=admin.local@setu.test
ADMIN_SEED_PASSWORD=change-me-local-admin-password
ADMIN_SEED_2FA_ENABLED=false
# Transactional mail is API-only. Leave disabled in local development unless you use a sandbox SMTP mailbox.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
MAIL_FROM_ADDRESS=
SMTP_TEST_RECIPIENT=
PUBLIC_SITE_URL=http://localhost:3000
ADMIN_SITE_URL=http://localhost:3001
ADMIN_NOTIFICATION_EMAIL=
ADMIN_QUOTE_NOTIFICATION_EMAIL=
SEED_PUBLIC_FIXTURES=false
# Enables an active example operating model only when running the development seed.
SEED_INSURANCE_DEMO_MODE=false
# Insurance administration is server-side gated and disabled by default.
INSURANCE_FEATURE_ENABLED=false
# Production requires this explicit release approval in addition to every other validation rule.
INSURANCE_PRODUCTION_APPROVED=false
INSURANCE_ADMIN_ENABLED=false
INSURANCE_PRODUCT_CATALOG_ENABLED=false
INSURANCE_CUSTOMER_NEEDS_ENABLED=false
INSURANCE_QUOTATION_ENABLED=false
INSURANCE_COMPARISON_ENABLED=false
INSURANCE_RANKING_ENABLED=false
INSURANCE_SAVED_QUOTES_ENABLED=false
INSURANCE_PROVIDER_INTEGRATIONS_ENABLED=false
INSURANCE_PURCHASE_HANDOFF_ENABLED=false
INSURANCE_PROVIDER_DEFAULT_TIMEOUT_MS=8000
INSURANCE_PROVIDER_MAX_RETRIES=1
# Comma-separated exact provider API hosts. Keep empty while integrations are disabled.
INSURANCE_PROVIDER_ALLOWED_HOSTS=
INSURANCE_HANDOFF_TTL_MINUTES=15
INSURANCE_WEBHOOK_MAX_BODY_BYTES=65536
INSURANCE_OPERATIONS_ENABLED=false
INSURANCE_OPERATIONS_RETRY_ENABLED=false
INSURANCE_CALLBACK_REPROCESS_ENABLED=false
INSURANCE_OPERATIONS_DEFAULT_WINDOW_HOURS=24
INSURANCE_EXPIRY_WARNING_DAYS=30
INSURANCE_QUOTE_TTL_DAYS=14
INSURANCE_NEED_ASSESSMENT_DRAFT_TTL_DAYS=30
INSURANCE_MAX_COVERED_MEMBERS=6
INSURANCE_SENSITIVE_DATA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
INSURANCE_DOCUMENT_MAX_FILE_SIZE_BYTES=10485760
INSURANCE_DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
INSURANCE_SIGNED_URL_TTL_SECONDS=120
INSURANCE_LICENCE_EXPIRY_WARNING_DAYS=60
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_DIR=.local-storage
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_PUBLIC_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
DOCUMENT_MAX_FILE_SIZE_BYTES=10485760
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
SIGNED_URL_TTL_SECONDS=300
DOCUMENT_SCAN_ENABLED=false
DOCUMENT_SCAN_FAIL_CLOSED=true
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
DOCUMENT_SCAN_TIMEOUT_MS=30000
ADMIN_2FA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
ADMIN_AUTH_CHALLENGE_SECRET=setu-local-admin-auth-challenge-secret-at-least-32-chars
ADMIN_AUTH_CHALLENGE_TTL=10m
ADMIN_TOTP_ISSUER=Setu
ADMIN_TOTP_WINDOW=2
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_SECONDS=300
ADMIN_2FA_MAX_ATTEMPTS=5
ADMIN_DOCUMENT_URL_TTL_SECONDS=120
INQUIRY_IDEMPOTENCY_TTL_SECONDS=900
JSON_BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=15000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_PREFIX=setu:ratelimit:
RATE_LIMIT_AUTH_LIMIT=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_INQUIRY_LIMIT=10
RATE_LIMIT_INQUIRY_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_LIMIT=5
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=300
