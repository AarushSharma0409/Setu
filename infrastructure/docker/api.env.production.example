# Copy to /opt/setu/api.env. Do not use local development values in production.
NODE_ENV=production
API_PORT=4000
CORS_ALLOWED_ORIGINS=https://setu.example.com,https://admin.setu.example.com
# Google Identity Services is used only for public-user sign-in.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
JWT_ACCESS_SECRET=replace-with-a-random-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-plus-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
ADMIN_2FA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
ADMIN_AUTH_CHALLENGE_SECRET=replace-with-a-random-32-plus-character-secret
ADMIN_AUTH_CHALLENGE_TTL=10m
ADMIN_TOTP_ISSUER=Setu
DOCUMENT_SCAN_ENABLED=true
DOCUMENT_SCAN_FAIL_CLOSED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
DOCUMENT_SCAN_TIMEOUT_MS=30000
SEED_PUBLIC_FIXTURES=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_PREFIX=setu:ratelimit:
JSON_BODY_LIMIT=1mb
REQUEST_TIMEOUT_MS=15000

# SMTP is configured only in the API environment. Use an authenticated TLS mailbox.
MAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
MAIL_FROM_ADDRESS=notifications@setu.example.com
SMTP_TEST_RECIPIENT=operations@setu.example.com
PUBLIC_SITE_URL=https://setu.example.com
ADMIN_SITE_URL=https://admin.setu.example.com
ADMIN_NOTIFICATION_EMAIL=operations@setu.example.com
ADMIN_QUOTE_NOTIFICATION_EMAIL=operations@setu.example.com

# Insurance remains disabled until a separate approved release process enables it.
INSURANCE_FEATURE_ENABLED=false
INSURANCE_PRODUCTION_APPROVED=false
INSURANCE_ADMIN_ENABLED=false
INSURANCE_PRODUCT_CATALOG_ENABLED=false
INSURANCE_CUSTOMER_NEEDS_ENABLED=false
INSURANCE_QUOTATION_ENABLED=false
INSURANCE_COMPARISON_ENABLED=false
INSURANCE_RANKING_ENABLED=false
INSURANCE_SAVED_QUOTES_ENABLED=false
INSURANCE_PROVIDER_INTEGRATIONS_ENABLED=false
INSURANCE_PURCHASE_HANDOFF_ENABLED=false
INSURANCE_OPERATIONS_ENABLED=false
INSURANCE_OPERATIONS_RETRY_ENABLED=false
INSURANCE_CALLBACK_REPROCESS_ENABLED=false
INSURANCE_SENSITIVE_DATA_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
