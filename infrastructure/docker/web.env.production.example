NODE_ENV=production
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WEB_URL=https://setu.example.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@setu.example.com
NEXT_PUBLIC_SUPPORT_PHONE=replace-with-published-support-number
# This value is baked into the container image at build time through the GitHub Actions GOOGLE_OAUTH_CLIENT_ID variable.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
