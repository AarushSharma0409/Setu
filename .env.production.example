# Copy to /opt/setu/.env on the Linux server and protect it with chmod 600.
# This file is consumed by Docker Compose and deployment scripts, not by browsers.
COMPOSE_PROJECT_NAME=setu-production
GHCR_OWNER=your-github-owner
SETU_IMAGE_TAG=replace-with-an-immutable-commit-sha

PUBLIC_DOMAIN=setu.example.com
ADMIN_DOMAIN=admin.setu.example.com
API_DOMAIN=api.setu.example.com
STORAGE_DOMAIN=storage.setu.example.com
CADDY_EMAIL=ops@example.com

POSTGRES_USER=setu
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=setu
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_MAXMEMORY_POLICY=noeviction

MINIO_ROOT_USER=setu-minio
MINIO_ROOT_PASSWORD=replace-with-a-long-random-minio-password
MINIO_BUCKET=setu-private
OBJECT_STORAGE_REGION=us-east-1

SETU_API_ENV_FILE=./api.env
SETU_WEB_ENV_FILE=./web.env
SETU_ADMIN_ENV_FILE=./admin.env
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
POSTGRES_BACKUP_DIR=/opt/setu/backups/postgres
POSTGRES_BACKUP_RETENTION_COUNT=14
OFFSITE_BACKUP_REQUIRED=true
OFFSITE_POSTGRES_BACKUP_S3_URI=s3://replace-with-offsite-backup-bucket/setu/postgres
OFFSITE_POSTGRES_S3_SSE=AES256
OFFSITE_POSTGRES_S3_SSE_KMS_KEY_ID=
OFFSITE_MINIO_ENDPOINT=https://replace-with-offsite-object-storage.example
OFFSITE_MINIO_ACCESS_KEY=replace-with-offsite-access-key
OFFSITE_MINIO_SECRET_KEY=replace-with-offsite-secret-key
OFFSITE_MINIO_BUCKET=setu-object-backups
OFFSITE_MINIO_PREFIX=setu-object-storage
SMOKE_PUBLIC_URL=https://setu.example.com
SMOKE_ADMIN_URL=https://admin.setu.example.com/login
SMOKE_API_URL=https://api.setu.example.com/api/v1
ALERT_WEBHOOK_URL=https://replace-with-alert-webhook
MONITOR_STATE_FILE=/opt/setu/runtime/monitor.state
INCIDENT_OWNER=replace-with-on-call-owner
SECURITY_CONTACT=security@example.com
BACKUP_OWNER=replace-with-backup-owner
